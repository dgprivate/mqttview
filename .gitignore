# Build output
/mqttview
/mqttview-mcp
/dist/
# web/dist is handled by web/.gitignore, which is the file git consults first
# for anything under web/. Saying it twice is how the exception below it came
# to be silently ineffective.
/web/node_modules/

# Runtime data — contains broker credentials and the encryption key
/data/
*.db
*.db-wal
*.db-shm
secret.key

# Local configuration and secrets
/mqttview.yaml
.env
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# The HACS integration is Python, and Python leaves these behind.
__pycache__/
*.py[cod]
