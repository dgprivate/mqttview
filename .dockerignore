# Keep the build context small and, more importantly, keep secrets out of it.
.git
.github

# Runtime state: broker credentials and the encryption key must never be
# baked into an image.
data/
*.db
*.db-wal
*.db-shm
secret.key
mqttview.yaml
# The compose environment file: it holds the encryption key and the bootstrap
# password. It never reaches the final image, but it has no business being in
# a builder layer either.
.env
!.env.example

# Build output — the image builds its own.
mqttview
web/node_modules/
web/dist/

# The Home Assistant packaging. The add-on image is built from this one rather
# than alongside it, and the HACS integration is Python that never enters it;
# both only make the context bigger and the cache easier to invalidate.
addon/
custom_components/

# Editors and docs that do not affect the build
.idea/
.vscode/
*.swp
.DS_Store
